# --- Secrets - never commit real env files ---
.env
.env.*
!.env.example

# --- Patient data - never commit, never serve statically ---
/storage/
/public/uploads/
# A dump is a complete copy of every patient record in the hospital. One
# accidental `git add .` would publish the lot, so the directory is ignored
# before the first backup is ever taken (see scripts/backup.ts).
/backups/

# --- Dependencies ---
node_modules
/.pnp
.pnp.*

# --- Next.js build output ---
/.next/
# Second dev server run alongside yours (NEXT_DIST_DIR in .claude/launch.json)
/.next-preview/
# Verification builds (NEXT_DIST_DIR=.next-verify). Its webpack cache holds
# single files over 100 MB, which GitHub rejects outright - never commit it.
/.next-verify/
# Same thing under the name a build check writes to. It was committed once and
# GitHub refused the push over a 278 MB webpack pack - the whole branch is
# blocked by it, so the name goes here rather than being remembered.
/.next-build-check/
# And the plain -build name, committed the same way: its server-production
# webpack pack reached 446 MB. Same rejection, same blocked branch.
/.next-build/
/out/
/build
next-env.d.ts

# --- Prisma generated client ---
/src/generated/
/prisma/generated/

# --- Testing ---
/coverage

# --- Logs & debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- OS / editor ---
.DS_Store
Thumbs.db
*.pem
.vscode/*
!.vscode/extensions.json
.idea

# --- Vercel ---
.vercel

# --- TypeScript ---
*.tsbuildinfo
