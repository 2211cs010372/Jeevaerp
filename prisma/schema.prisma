// =============================================================================
// Jeeva Multispeciality Hospital ERP - schema v2.0 (production)
// =============================================================================
// Policies:
//   * Money is always Decimal(10,2); GST rates Decimal(4,2). Never Float.
//   * Medical records are never hard-deleted. Users/doctors/medicines are
//     deactivated (isActive/active=false); patients are merged, not removed.
//   * Referential actions stay at Prisma defaults (required -> Restrict).
//   * Every human-facing number (JMH/OP/INV) comes from the Counter table
//     via one atomic INSERT ... ON CONFLICT ... RETURNING statement.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime: pooled (pgbouncer, port 6543). Migrations/DDL: direct session
  // connection (port 5432) - pgbouncer can't run migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  PATIENT
  DOCTOR
  RECEPTIONIST
  LAB_TECH
  PHARMACIST
  /// The insurance desk - the person in the insurance room who raises claims
  /// with insurers and TPAs. A role of their own rather than ADMIN, because the
  /// only alternative was handing them HR, salaries, accounts and the audit log
  /// to let them submit a pre-auth.
  INSURANCE_DESK
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum AppointmentType {
  WALKIN
  ONLINE
  EMERGENCY
  CASUALTY
}

/// Lifecycle of a callback request raised from the public website.
enum AppointmentRequestStatus {
  /// Phone verified, sitting in the reception queue. Nobody has rung yet.
  NEW
  /// Reception has spoken to them but no visit exists yet.
  CONTACTED
  /// Turned into a real Appointment - `appointmentId` points at it.
  BOOKED
  /// Dealt with without a booking: wrong number, changed their mind, duplicate.
  CLOSED
}

// ---------------------------------------------------------------------------
// Insurance / cashless claims
// ---------------------------------------------------------------------------

enum ClaimType {
  CASHLESS // hospital bills the insurer/TPA directly
  REIMBURSEMENT // patient pays, then claims back
}

/// WHO SETTLES A BILL - and therefore whether it is money at all.
///
/// SELF_PAY is the ordinary counter bill: someone hands over cash, UPI or a card,
/// the money enters a drawer, and it belongs in that drawer's day close.
///
/// INSURANCE means the hospital billed an insurer or TPA directly (cashless).
/// Nothing was tendered at the desk. Counting such a bill as a collection would
/// inflate every reconciliation in the building, and leaving it in "outstanding"
/// would tell a receptionist to go and chase a family who owes nothing - so it is
/// shown on the day close, deliberately, but never added up.
///
/// Reimbursement claims are NOT this. There the patient pays the counter in full
/// and claims the money back from their insurer themselves: the drawer really did
/// receive that cash, so the bill stays SELF_PAY and a claim is raised beside it.
enum PayerType {
  SELF_PAY
  INSURANCE
}

enum ClaimStage {
  PRE_AUTH // pre-authorization, raised at/soon after admission
  FINAL // final claim, raised at discharge with the actual bill
}

/// The lifecycle every claim moves through. Each move writes a ClaimEvent so
/// the timeline is a real audit trail, not a single mutable status field.
enum ClaimStatus {
  DRAFT
  SUBMITTED // sent to the insurer/TPA - "applied"
  QUERIED // insurer wants more documents/info
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  SETTLED // money received
  CLOSED
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  COMPLETED
  CANCELLED
}

enum LabTestStatus {
  PENDING
  COMPLETED
}

/// Lifecycle of a scanned handwritten prescription as it moves through the ERP.
enum PrescriptionStatus {
  UPLOADED // reception scanned it
  SENT_TO_PHARMACY // reception dispatched it to the pharmacy queue
  DISPENSED // pharmacy dispensed against it
  CANCELLED
}

enum StockTxType {
  PURCHASE
  DISPENSE
  ADJUSTMENT
  RETURN
  /// Stock sent BACK to the distributor - expiry credit, damage, wrong supply.
  /// Carries -qty, like a dispense, but the money comes back to the hospital
  /// instead of from a patient.
  PURCHASE_RETURN
}

/// A purchase order's life. DRAFT is editable; once SENT the supplier has it
/// and the lines are frozen - what changes after that is how much has ARRIVED,
/// which only a goods receipt may move.
enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// Where a supplier return has got to. Credit notes take weeks in Indian
/// pharma distribution, so "sent" and "settled" are genuinely different states
/// and the difference is money the hospital is owed.
enum PurchaseReturnStatus {
  DRAFT
  SENT
  CREDITED
  REJECTED
}

/// Which desk raised the invoice - powers category-wise revenue in admin.
enum InvoiceSource {
  CONSULTATION
  LAB
  PHARMACY
  IPD
  OTHER
}

/// Everything that can land on an inpatient's final bill.
enum ChargeCategory {
  PROCEDURE
  DOCTOR_VISIT
  NURSING
  OXYGEN
  INVESTIGATION
  CONSUMABLE
  PHARMACY
  OTHER
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

/// How a stay ended.
///
/// It was ADMITTED | DISCHARGED, which could not express the ways a 50-bed
/// hospital's stays actually end. A death was filed as a discharge because the
/// system offered nothing else, and once staff learn to enter something untrue to
/// make the software accept reality, every count downstream is fiction.
///
/// ONE OPEN STATE, FOUR CLOSED ONES. Every "is this stay live?" check in the code
/// asks `status === ADMITTED` or `!== ADMITTED`, so adding closed states cannot
/// silently reopen a closed stay. Anything reporting on CLOSURES has to name all
/// four - see recentDischarges and ipdStats, which previously matched DISCHARGED
/// alone and would have dropped these rows on the floor.
enum AdmissionNoteKind {
  /// Shift-handover observation typed at the ward desk.
  NURSING
  /// The closing note the discharge step records. Kept in the same stream so
  /// the summary reads one chronology, not two.
  DISCHARGE
}

enum AdmissionStatus {
  ADMITTED
  /// Discharged on medical advice, the ordinary ending.
  DISCHARGED
  /// Left against medical advice, having signed. LAMA/DAMA on paper.
  LAMA
  /// Left without telling anyone and without signing. Medico-legally distinct
  /// from LAMA: nobody obtained consent, so it cannot be recorded as one.
  ABSCONDED
  /// Referred out to another hospital mid-stay.
  TRANSFERRED_OUT
  /// Died during the stay.
  EXPIRED
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  NETBANKING
  OTHER
}

/// Where a bill stands with the government's Invoice Registration Portal.
///
/// An IRN is NOT something this system can mint. It is a 64-character hash the
/// IRP returns after it has accepted the invoice, and only the IRP can issue
/// one. So this enum tracks a conversation with an outside authority, not an
/// internal state machine: FAILED is a real, common, recoverable outcome
/// (a wrong GSTIN, a duplicate invoice number) and must be distinguishable
/// from "nobody has tried yet".
enum EInvoiceStatus {
  /// Eligible and not yet submitted.
  PENDING
  /// The IRP accepted it and returned an IRN.
  GENERATED
  /// The IRP rejected it. errorCode / errorMessage say why.
  FAILED
  /// Cancelled at the IRP. Only possible within 24h of generation.
  CANCELLED
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

/// Staff identity only. Patients are NOT users - they authenticate against
/// the Patient table via OTP (families share phone numbers; User.phone is
/// unique, Patient.phone is not).
model User {
  id           String    @id @default(cuid())
  /// Portal login handle, e.g. "reception.ravi" (role.name). Unique.
  username     String    @unique
  phone        String    @unique
  /// OTP backup channel - used to send a staff login code if they exist in DB.
  email        String?   @unique
  name         String
  passwordHash String?
  role         Role
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  doctorProfile       Doctor?
  appointmentsCreated Appointment[]      @relation("AppointmentCreatedBy")
  labTestsHandled     LabTest[]          @relation("LabTestTechnician")
  stockTransactions   StockTransaction[]
  invoicesCreated     Invoice[]          @relation("InvoiceCreatedBy")
  paymentsReceived    Payment[]          @relation("PaymentReceivedBy")
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  otps                Otp[]
  admissionCharges    AdmissionCharge[]  @relation("AdmissionChargeAddedBy")

  refundsIssued  Refund[]           @relation("RefundedBy")
  bedMoves       BedStay[]          @relation("BedStayMovedBy")
  advancesTaken  AdmissionAdvance[] @relation("AdvanceReceivedBy")
  vitalsRecorded Vitals[]           @relation("VitalsRecordedBy")
  claimsCreated  InsuranceClaim[]   @relation("ClaimCreatedBy")
  claimEvents    ClaimEvent[]       @relation("ClaimEventBy")
  sessions       StaffSession[]     @relation("UserSessions")

  purchaseOrders  PurchaseOrder[]      @relation("PurchaseOrderCreatedBy")
  goodsReceipts   GoodsReceipt[]       @relation("GoodsReceiptReceivedBy")
  purchaseReturns PurchaseReturn[]     @relation("PurchaseReturnCreatedBy")
  requestsHandled AppointmentRequest[] @relation("BookingRequestHandledBy")
  eInvoicesRaised EInvoice[]           @relation("EInvoiceGeneratedBy")
  admissionNotes  AdmissionNote[]      @relation("AdmissionNoteAuthor")
}

model Patient {
  // ---- Primary identifiers ----
  id        String @id @default(cuid())
  /// Internal UUID for external APIs.
  uuid      String @unique @default(uuid())
  /// Printed on OP/IP slips (JMH2026OP00123). Patient logs in with this.
  displayId String @unique

  // ---- Name (split for records, fullName denormalized for search) ----
  firstName  String
  middleName String?
  lastName   String?
  fullName   String

  // ---- Demographics ----
  dob           DateTime?      @db.Date
  /// Captured when DOB is unknown (common for walk-ins).
  age           Int?
  gender        Gender?
  /// Kept as a validated string ("A+", "O-", …) - blood-group symbols aren't
  /// valid Prisma enum identifiers, so a checked string is the clean choice.
  bloodGroup    String?
  maritalStatus MaritalStatus?

  // ---- Contact ----
  phone          String
  alternatePhone String?
  email          String?
  address        String?
  city           String?
  state          String?
  country        String? @default("India")
  postalCode     String?

  // ---- Personal ----
  occupation        String?
  nationality       String?
  preferredLanguage String?
  photoUrl          String?

  // ---- Emergency contact ----
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?

  // ---- Medical ----
  allergies String?

  // ---- Identification ----
  govtIdNumber String?

  // ---- Referral (ADMIN-ONLY, snapshot at registration) ----
  /// Who referred this patient to the hospital. Snapshot string, not a live
  /// FK - the value recorded at registration never drifts. Strip from every
  /// non-admin serializer.
  referredByName String?
  referralSource String?

  // ---- Flags ----
  isVip      Boolean   @default(false)
  isActive   Boolean   @default(true)
  isDeceased Boolean   @default(false)
  deceasedAt DateTime?

  // ---- Duplicate merge (losing record points at the survivor) ----
  mergedIntoId String?
  mergedInto   Patient?  @relation("PatientMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Patient[] @relation("PatientMerge")

  // ---- System / audit ----
  remarks     String?
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // ---- Relations ----
  appointments        Appointment[]
  invoices            Invoice[]
  labTests            LabTest[]
  prescriptionUploads PrescriptionUpload[]
  admissions          Admission[]
  otps                Otp[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  insuranceClaims     InsuranceClaim[]     @relation("PatientClaims")

  @@index([displayId])
  @@index([uuid])
  @@index([phone])
  @@index([fullName])
  @@index([dob])
  @@index([isActive])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Doctors, schedules & appointments
// ---------------------------------------------------------------------------

model Doctor {
  id              String  @id @default(cuid())
  userId          String? @unique
  user            User?   @relation(fields: [userId], references: [id])
  name            String
  specialization  String
  department      String
  consultationFee Decimal @db.Decimal(10, 2)
  active          Boolean @default(true)

  // ---- Profile (for booking + public directory cards) ----
  qualification   String?
  experienceYears Int?
  age             Int?
  languages       String?
  photoUrl        String?
  bio             String?

  schedules       DoctorSchedule[]
  slots           DoctorSlot[]
  appointments    Appointment[]
  prescriptions   Prescription[]
  admissions      Admission[]
  bookingRequests AppointmentRequest[]
  /// Tests referred by this doctor that came in without a consultation here.
  labReferrals    LabTest[]            @relation("LabTestReferrer")

  @@index([department])
}

/// A callback request raised from the public website.
///
/// This is deliberately NOT an Appointment. The website's slot-booking path
/// writes a real, confirmed visit; this path writes an INTENT - "this person
/// wants to see this doctor, please ring them". Reception owns the diary and
/// decides the time.
///
/// It exists because the slot grid asks a patient to commit to a minute before
/// they have spoken to anyone, and many will not. A name, a number and a
/// doctor is the smallest thing a hospital needs to call someone back.
///
/// No Patient row is created here. An unverified enquiry must never enter the
/// master patient index - a fictional or duplicate patient is a clinical safety
/// problem, not untidy data. The phone IS verified by OTP before this row
/// exists, so the queue cannot be filled by a script.
model AppointmentRequest {
  id    String @id @default(cuid())
  /// Quoted to the patient on screen and by SMS - REQ-2026-000012.
  refNo String @unique

  patientName String
  /// Verified by one-time code before this row was written. 10 digits.
  phone       String

  /// Who they asked for. Optional: "any available doctor" is a real answer,
  /// and forcing a choice makes people pick wrongly.
  doctorId String?
  doctor   Doctor? @relation(fields: [doctorId], references: [id])

  /// When they would like to come, if they said. Date only - the exact time is
  /// reception's to set.
  preferredDate DateTime? @db.Date
  /// What they typed. Symptoms, timing preference, anything.
  note          String?

  status AppointmentRequestStatus @default(NEW)

  /// The visit this became. Unique: one request cannot spawn two visits.
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  /// What happened when reception rang - kept even after closing, because
  /// "number not reachable x3" is the answer to "why was this never booked".
  handledNote String?
  handledById String?
  handledBy   User?     @relation("BookingRequestHandledBy", fields: [handledById], references: [id])
  handledAt   DateTime?

  createdAt DateTime @default(now())
  ipAddress String?

  /// The queue is read as "oldest NEW first" all day - this serves it directly.
  @@index([status, createdAt])
  /// Spotting a repeat caller before ringing them back.
  @@index([phone])
}

/// Weekly recurring OPD template. Concrete DoctorSlot rows are generated
/// from this (cron or on-demand) - reception never hand-creates slots.
model DoctorSchedule {
  id              String  @id @default(cuid())
  doctorId        String
  doctor          Doctor  @relation(fields: [doctorId], references: [id])
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek       Int
  startTime       String
  endTime         String
  slotDurationMin Int     @default(10)
  isActive        Boolean @default(true)

  @@unique([doctorId, dayOfWeek, startTime])
}

model DoctorSlot {
  id          String   @id @default(cuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id])
  date        DateTime @db.Date
  /// "HH:MM" 24h - display + equality only.
  startTime   String
  endTime     String
  isBooked    Boolean  @default(false)
  /// Doctor unavailable for this slot - leave, surgery, emergency. Distinct from
  /// isBooked: a blocked slot has no patient, it simply can't be sold.
  isBlocked   Boolean  @default(false)
  blockReason String?

  appointment Appointment?

  @@unique([doctorId, date, startTime])
  @@index([doctorId, date, isBooked])
}

model Appointment {
  id            String      @id @default(cuid())
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  /// NULLABLE on purpose: an EMERGENCY / CASUALTY visit gets its OP number the
  /// moment the patient is carried in, before anyone knows which consultant
  /// will see them. Every serializer must therefore treat doctor as optional -
  /// the printed sheet falls back to the duty-doctor signature block.
  doctorId      String?
  doctor        Doctor?     @relation(fields: [doctorId], references: [id])
  /// Unique -> one appointment per slot: DB-level double-booking guarantee.
  /// NULLABLE on purpose: a CANCELLED visit releases its slot (Postgres allows
  /// many NULLs under a unique index), so the slot can be booked by someone else.
  /// Without this, every cancellation would burn a slot permanently.
  slotId        String?     @unique
  slot          DoctorSlot? @relation(fields: [slotId], references: [id])
  /// Denormalized from slot.date - makes "today's queue" a single-table query.
  visitDate     DateTime    @db.Date
  /// Denormalized from slot.startTime ("HH:MM"), same reason as visitDate - and it
  /// survives the slot being released on cancellation.
  timeAtBooking String      @default("00:00")

  type     AppointmentType
  status   AppointmentStatus @default(BOOKED)
  opNumber String            @unique

  /// Snapshot of the consultation fee at the moment of booking (money never
  /// shifts under a booked visit even if the doctor's fee changes later).
  priceAtBooking Decimal @db.Decimal(10, 2)

  /// ADMIN-ONLY per-visit referral snapshot. Who referred the patient FOR THIS
  /// visit. Must be stripped from every non-admin serializer.
  referredByName String?
  referralSource String?

  checkedInAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  createdById String
  createdBy   User     @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  prescription        Prescription?
  prescriptionUploads PrescriptionUpload[]
  vitals              Vitals?
  labTests            LabTest[]
  invoices            Invoice[]
  /// The website request this visit was raised from, if any.
  bookingRequest      AppointmentRequest?

  @@index([doctorId, visitDate, status])
  @@index([patientId, createdAt])
  // Reception counts/lists filter by date+status WITHOUT a doctor, so the
  // doctor-led index above can't serve them - this one does.
  @@index([visitDate, status])
  // Casualty pulls "today's emergencies" and admin counts monthly emergency
  // footfall; both filter by type with no doctor and no status.
  @@index([visitDate, type])
}

// ---------------------------------------------------------------------------
// Clinical
// ---------------------------------------------------------------------------

/// Vitals for one OP visit - BP, pulse, height, weight, temp, SpO2. The paper
/// OPD sheet prints these as blank ruled boxes at booking (triage pen fills
/// them by hand); reception then types the handwritten numbers in here,
/// exactly like PrescriptionUpload does for the ℞ table. One row per visit.
model Vitals {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  bpSystolic  Int? // mmHg
  bpDiastolic Int? // mmHg
  pulse       Int? // bpm
  tempF       Decimal? @db.Decimal(4, 1)
  spo2        Int? // %
  heightCm    Decimal? @db.Decimal(5, 1)
  weightKg    Decimal? @db.Decimal(5, 1)
  // BMI / BSA are derived from height + weight at read time, not stored -
  // they'd go stale the moment either input is corrected.

  recordedById String
  recordedBy   User     @relation("VitalsRecordedBy", fields: [recordedById], references: [id])
  recordedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Prescription {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  diagnosis     String
  nextVisitDate DateTime?   @db.Date
  notes         String?
  createdAt     DateTime    @default(now())

  items PrescriptionItem[]
  // Advised tests are NOT stored as JSON: saving a prescription creates
  // LabTest rows on the appointment - those rows are the source of truth.
}

/// A scanned/uploaded prescription document (PDF or image). Reception scans the
/// paper prescription after a visit and uploads it; it attaches to the visit
/// AND the patient, so the patient sees it in their profile by UHID.
model PrescriptionUpload {
  id            String       @id @default(cuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  /// Public URL (Cloudinary) OR local path (/uploads/...) depending on storage.
  /// Null for a TYPED prescription - that has no file; its OPD sheet is rendered
  /// live from the ℞ items + clinical fields below. Only a genuine SCANNED upload
  /// (photo/PDF of a handwritten Rx) carries a file.
  fileUrl      String?
  /// Storage backend used, so we know how to build/serve the URL.
  storage      String   @default("local")
  fileName     String?
  mimeType     String?
  fileSize     Int?
  /// Free-text title, e.g. "Rheumatology consult - 27 May".
  title        String?
  uploadedById String
  createdAt    DateTime @default(now())

  /// The doctor writes by hand; reception scans and dispatches it through the
  /// ERP. This tracks where the scan has got to.
  status           PrescriptionStatus @default(UPLOADED)
  sentToPharmacyAt DateTime?
  dispensedAt      DateTime?
  dispensedById    String?
  /// Which doctor's handwriting this is (snapshot, from the visit).
  doctorName       String?

  /// Clinical details typed from the handwritten sheet, printed onto the
  /// generated OPD PDF.
  diagnosis   String?
  advice      String?
  /// DEPRECATED - superseded by the advisedLabs rows below. Was newline-
  /// separated test names that nothing could act on. Kept for one release so
  /// the backfill can be checked before the column is dropped.
  labsAdvised String?
  nextVisit   String?
  /// Presenting complaints and history as the doctor took them - the top block
  /// of the OPD sheet. Free prose on purpose: "fever 3 days, no vomiting, k/c/o
  /// diabetes" is how it is written on paper and any attempt to structure it
  /// into fields at a reception desk loses the sentence that mattered.
  caseHistory String?

  invoices    Invoice[]
  items       PrescriptionUploadItem[]
  advisedLabs PrescriptionUploadLab[]

  /// An inpatient prescription belongs to the STAY, not to an OPD appointment.
  /// Exactly one of appointmentId / admissionId is normally set.
  admissionId String?
  admission   Admission? @relation(fields: [admissionId], references: [id])

  @@index([patientId, createdAt])
  @@index([appointmentId])
  @@index([status, sentToPharmacyAt])
}

/// A medicine line typed by reception while uploading the scan. Free text by
/// design (they're transcribing handwriting) with an optional link into the
/// pharmacy master when the name matches - that link is what lets the
/// pharmacist dispense in two clicks instead of re-reading the scan.
model PrescriptionUploadItem {
  id       String             @id @default(cuid())
  uploadId String
  upload   PrescriptionUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  /// As typed by reception - survives catalog renames.
  medicineName String
  medicineId   String?
  medicine     Medicine? @relation(fields: [medicineId], references: [id])
  qty          Int       @default(1)
  /// Free text: "1-0-1 after food", "5 days", etc.
  dosage       String?

  @@index([uploadId])
}

/// A test the doctor ADVISED on the OPD sheet.
///
/// This used to be newline-joined free text in PrescriptionUpload.labsAdvised,
/// which printed correctly and could not be acted on: nothing turned advice into
/// a LabTest, and nothing could answer "which advised tests were never ordered".
/// A test the doctor asked for and nobody re-typed simply did not happen, and no
/// screen showed the difference. In a small hospital there is no second person
/// downstream to catch that.
///
/// Free text is still the SOURCE - reception is transcribing handwriting, and
/// the catalog will never hold every phrase a doctor writes. `catalogId` is the
/// optional resolution into the master, and `labTestId` is the order that
/// actually fulfilled the advice. Advised-but-not-ordered is exactly the rows
/// where labTestId is null.
model PrescriptionUploadLab {
  id       String             @id @default(cuid())
  uploadId String
  upload   PrescriptionUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  /// As typed / as written on the sheet. Survives catalog renames.
  testName String

  /// Resolved into the lab master when the name matches one. Null when the
  /// doctor wrote something the catalog does not stock - that advice still
  /// prints, it just cannot be ordered in one click.
  catalogId String?
  catalog   LabTestCatalog? @relation(fields: [catalogId], references: [id])

  /// The order raised against this advice. Null means NOT YET ORDERED, which is
  /// the whole point of this table.
  labTestId String?  @unique
  labTest   LabTest? @relation(fields: [labTestId], references: [id])

  /// Set when someone deliberately decides the test is not needed, so the
  /// outstanding list can be cleared honestly instead of ignored. The reason is
  /// required by the service - "declined" with no reason is not a record.
  declinedAt     DateTime?
  declinedReason String?

  createdAt DateTime @default(now())

  @@index([uploadId])
  @@index([labTestId])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  /// Optional link into the pharmacy master (doctor may prescribe unstocked items).
  medicineId     String?
  medicine       Medicine?    @relation(fields: [medicineId], references: [id])
  /// Snapshot of the name as written - survives master renames.
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  instructions   String?

  @@index([prescriptionId])
}

model LabTestCatalog {
  id         String  @id @default(cuid())
  name       String  @unique
  code       String? @unique
  price      Decimal @db.Decimal(10, 2)
  gstRatePct Decimal @default(0) @db.Decimal(4, 2)
  active     Boolean @default(true)

  labTests  LabTest[]
  analytes  LabAnalyte[]
  advisedOn PrescriptionUploadLab[]
}

/// How a numeric result compares with its reference range. A report that only
/// says "5.2" makes the doctor do the arithmetic; this is what lets the screen
/// shout when something is out of range.
enum LabResultFlag {
  NORMAL
  HIGH
  LOW
  /// Non-numeric result the lab marked as not-normal ("Positive", "Growth seen").
  ABNORMAL
}

/// TEMPLATE: which analytes a catalogued test reports, and their normal range.
/// A CBP reports haemoglobin, WBC, platelets - the technician shouldn't retype
/// those names or ranges for every patient.
model LabAnalyte {
  id        String         @id @default(cuid())
  catalogId String
  catalog   LabTestCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  name      String
  unit      String?
  refLow    Decimal?       @db.Decimal(12, 4)
  refHigh   Decimal?       @db.Decimal(12, 4)
  /// For results that aren't numbers: "Negative", "Nil", "Clear".
  refText   String?
  sortOrder Int            @default(0)

  @@unique([catalogId, name])
  @@index([catalogId, sortOrder])
}

/// One measured line on a finished test.
///
/// Name, unit and range are SNAPSHOT here rather than read through the catalog:
/// a report already handed to a patient must never change because someone later
/// edited a reference range. Same reasoning as priceAtOrder.
model LabResultItem {
  id        String        @id @default(cuid())
  labTestId String
  labTest   LabTest       @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  name      String
  unit      String?
  /// As reported - a number ("13.4") or text ("Negative").
  value     String
  /// The parsed numeric form, when there is one. Drives flagging and trends.
  valueNum  Decimal?      @db.Decimal(12, 4)
  refLow    Decimal?      @db.Decimal(12, 4)
  refHigh   Decimal?      @db.Decimal(12, 4)
  refText   String?
  flag      LabResultFlag @default(NORMAL)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([labTestId, sortOrder])
}

model LabTest {
  id            String          @id @default(cuid())
  /// THE ORDER these tests were raised in - one value shared by every test
  /// picked in a single submit.
  ///
  /// A patient who gives one tube for a CBP, an LFT and a TSH is three rows
  /// here (each has its own analytes, its own price and its own completion) but
  /// ONE job at the bench and one line in the queue. Without this column the
  /// queue had no way to say so: it showed three unrelated rows, and the
  /// technician re-read the patient's name three times to convince themselves
  /// it was the same person.
  ///
  /// Nullable because tests ordered before this column existed have no order to
  /// belong to; those are read as an order of one. Not a foreign key - there is
  /// no LabOrder table and inventing one would put a row in the way of the
  /// clinically important thing, which is the test.
  orderGroupId  String?
  /// Optional: walk-in lab tests have no doctor appointment.
  appointmentId String?
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id])
  /// WHO ASKED FOR THE TEST, when no visit in this hospital did.
  ///
  /// A sample given at the lab window against an outside chit has no
  /// Appointment and therefore no doctor, so its report printed "Ref. Doctor:
  /// Self / walk-in" for a patient who was standing there holding a referral.
  /// This names that doctor without inventing a consultation that never
  /// happened - no OP number is minted and nothing is billed for it.
  ///
  /// The visit still wins where there is one: a test ordered off a
  /// consultation takes its referring doctor from the appointment, and this
  /// column is what the desk fills in when there is no consultation to take it
  /// from.
  referringDoctorId String?
  referringDoctor   Doctor?     @relation("LabTestReferrer", fields: [referringDoctorId], references: [id])
  /// A lab test always belongs to a patient (direct link, survives no-appointment case).
  patientId     String?
  patient       Patient?        @relation(fields: [patientId], references: [id])
  catalogId     String?
  catalog       LabTestCatalog? @relation(fields: [catalogId], references: [id])
  /// Snapshot of name + price at order time - survives catalog price changes.
  testName      String
  priceAtOrder  Decimal?        @db.Decimal(10, 2)

  status           LabTestStatus @default(PENDING)
  reportFileUrl    String?
  reportUploadedAt DateTime?
  technicianId     String?
  technician       User?         @relation("LabTestTechnician", fields: [technicianId], references: [id])
  createdAt        DateTime      @default(now())
  /// The date the DESK says this sample was registered, when that is not the
  /// moment it was typed in.
  ///
  /// A sample taken on Saturday evening and entered on Monday morning printed
  /// "Registered On: Monday" - a date the patient can see is wrong on a
  /// document they carry to another hospital. This is that correction, and it
  /// is a SEPARATE column on purpose: `createdAt` stays the untouched record of
  /// when the row was actually written, so the day's takings, the queue order
  /// and the audit trail all still read the real clock. Null on everything
  /// nobody has had to correct - the report falls back to createdAt.
  orderedAt        DateTime?
  completedAt      DateTime?
  /// The lab's read of its OWN numbers, written by the technician as the results
  /// are saved: "Microcytic hypochromic anaemia", "Growth of E. coli, sensitive
  /// to nitrofurantoin".
  ///
  /// This is an IMPRESSION, not the patient's diagnosis. A lab reports on a
  /// specimen; the doctor diagnoses the person, weighing this against the
  /// history and examination. It is stored and printed under the lab's name and
  /// never overwrites PrescriptionUpload.diagnosis, which is the doctor's.
  ///
  /// Attribution needs no extra columns: it is written in the same transaction
  /// that stamps technicianId and completedAt.
  impression       String?

  invoiceItems InvoiceItem[]
  results      LabResultItem[]
  /// Set when this order was raised FROM a doctor's written advice, closing the
  /// loop back to the OPD sheet that asked for it.
  advisedFrom  PrescriptionUploadLab?
  /// An INPATIENT's tests charge to the room tab, not the counter.
  /// Exactly one of appointmentId / admissionId is normally set.
  admissionId  String?
  admission    Admission?             @relation(fields: [admissionId], references: [id])

  @@index([status])
  @@index([appointmentId])
  @@index([admissionId])
  /// The queue reads by order, and the result sheet pulls an order's siblings.
  @@index([orderGroupId])
}

// ---------------------------------------------------------------------------
// Pharmacy - master + batches + ledger
// ---------------------------------------------------------------------------

/// One row per medicine. Reorder threshold lives HERE (compared against the
/// SUM of batch quantities), not on individual batches.
model Medicine {
  id                  String    @id @default(cuid())
  name                String    @unique
  genericName         String?
  manufacturer        String?
  /// HSN code for GST filing.
  hsnCode             String?
  /// Medicines are commonly 5% or 12% GST in India - set per item.
  gstRatePct          Decimal   @default(5.00) @db.Decimal(4, 2)
  /// The DISPENSING unit - what one of these is when handed to a patient:
  /// "tablet", "ml", "capsule". Never the pack.
  unit                String    @default("tablet")
  /// Default dispensing units per pack for this product ("15T" -> 15). A
  /// starting point for the receive screen; the batch records what actually
  /// arrived, because a distributor can change pack size between consignments.
  defaultPackSize     Int       @default(1)
  /// TRUE for antibiotics, TB drugs, antimalarials - anything where stopping the
  /// course early is actively harmful (it breeds resistance rather than just
  /// leaving the patient undertreated). The dispense scratchpad refuses to
  /// quietly short-supply these: it warns, and it records why.
  courseCritical      Boolean   @default(false)
  reorderThreshold    Int       @default(10)
  /// How much to bring the shelf up to when reordering. Null -> the reorder
  /// engine falls back to 3x the threshold, which is the usual month's cover.
  reorderQty          Int?
  rackLocation        String?
  active              Boolean   @default(true)
  /// Who we normally buy this from. Purely a default: it groups the reorder
  /// list into one draft PO per distributor instead of one line per medicine.
  preferredSupplierId String?
  preferredSupplier   Supplier? @relation("MedicinePreferredSupplier", fields: [preferredSupplierId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  batches           StockBatch[]
  prescriptionItems PrescriptionItem[]
  uploadItems       PrescriptionUploadItem[]
  poItems           PurchaseOrderItem[]
  grnItems          GoodsReceiptItem[]
  returnItems       PurchaseReturnItem[]

  @@index([preferredSupplierId])
}

/// One row per physical batch on the shelf. Dispensing is FEFO:
/// first-expiry, first-out - the [medicineId, expiryDate] index serves it.
model StockBatch {
  id            String   @id @default(cuid())
  medicineId    String
  medicine      Medicine @relation(fields: [medicineId], references: [id])
  batchNo       String
  expiryDate    DateTime @db.Date
  quantity      Int      @default(0)
  /// Landed cost PER PACK, exactly as invoiced. Divide by packSize for the
  /// per-unit cost - see perUnitPrice in lib/pharmacy/pack.
  purchasePrice Decimal? @db.Decimal(10, 2)
  /// Printed MRP PER PACK, as it appears on the carton. Deliberately not
  /// rewritten into a per-tablet figure: the MRP on the box is a legal number
  /// the patient can read, and the bill must agree with it. Billing divides by
  /// packSize at the point of sale.
  mrp           Decimal  @db.Decimal(10, 2)

  // ---- As printed on the distributor's invoice ----------------------------
  // The shelf is read against the bill it arrived on, so the batch carries the
  // invoice's own columns rather than a normalised interpretation of them.
  /// Strip / bottle size exactly as printed: "15T", "200ML", "5S". Free text on
  /// purpose - it is a label the pharmacist matches against the carton, and
  /// parsing it would invent precision the invoice never had.
  pack       String?
  /// Dispensing units in one purchased pack, read from `pack` ("15T" -> 15).
  ///
  /// THE CONVERSION THE WHOLE PHARMACY TURNS ON. `quantity` above is in
  /// DISPENSING UNITS (tablets, ml); a distributor sells PACKS. Receiving
  /// "QTY 3" of a 15T strip puts 45 tablets on the shelf, not 3.
  ///
  /// Defaults to 1 so stock booked in before this existed keeps meaning exactly
  /// what it meant - loose units, nothing retroactively multiplied.
  packSize   Int      @default(1)
  /// Free goods on this consignment, in DISPENSING UNITS to match `quantity`.
  /// Real stock carrying no invoice value; already counted inside `quantity`,
  /// held separately so landed cost per unit stays honest.
  freeQty    Int      @default(0)
  /// The invoice's OMrp column. On these distributors' bills it carries the
  /// manufacturer's short code (ARIS, AVEN, GLEN, U.S.), so it is text.
  oMrp       String?
  /// Where this physical stock came from. REQUIRED - every batch on the shelf
  /// must trace to a distributor, or a recall cannot be answered and a purchase
  /// return goes back to the wrong company. Stock that predates procurement is
  /// attached to the "Opening stock" supplier rather than left blank, so the
  /// gap is visible instead of silent.
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transactions StockTransaction[]
  invoiceItems InvoiceItem[]
  grnItems     GoodsReceiptItem[]
  returnItems  PurchaseReturnItem[]

  /// THE SUPPLIER IS PART OF THE BATCH'S IDENTITY.
  ///
  /// Keyed on [medicineId, batchNo] alone, the same manufacturer batch arriving
  /// from a second distributor merged into the first row: quantities were added
  /// together, `supplierId` and `purchasePrice` were overwritten by whoever
  /// delivered last, and the first distributor's consignment silently ceased to
  /// exist. That breaks a recall (which units came from whom?), a purchase
  /// return (back to which company?) and the margin on the remaining stock.
  ///
  /// Each consignment is now its own row. FEFO still works - it sorts on
  /// expiryDate, which is unchanged by this.
  @@unique([medicineId, batchNo, supplierId])
  @@index([medicineId, expiryDate])
  @@index([expiryDate])
  @@index([supplierId])
}

/// Ledger: batch quantity is only ever a side effect of rows written here.
/// PURCHASE/RETURN carry +qty, DISPENSE/PURCHASE_RETURN carry -qty,
/// ADJUSTMENT either.
model StockTransaction {
  id            String      @id @default(cuid())
  batchId       String
  batch         StockBatch  @relation(fields: [batchId], references: [id])
  type          StockTxType
  qty           Int
  /// The document this movement belongs to: invoice receiptNo (dispense),
  /// GRN number (purchase), or return note number (purchase return).
  refId         String?
  reason        String?
  performedById String
  performedBy   User        @relation(fields: [performedById], references: [id])
  createdAt     DateTime    @default(now())

  @@index([batchId, createdAt])
}

// ---------------------------------------------------------------------------
// Pharmacy procurement - supplier -> purchase order -> goods receipt -> stock
// ---------------------------------------------------------------------------
// The inbound half of the pharmacy. Without it a batch appears on the shelf
// with no answer to "who sold us this, at what price, against which order?" -
// which is exactly the question asked when a drug is recalled, when a bill is
// disputed, and by the drug inspector.
//
// The chain of custody is: PurchaseOrder (intent) -> GoodsReceipt (arrival,
// the ONLY thing that creates stock from a supplier) -> StockBatch (shelf).
// A goods receipt is never edited after posting; a mistake is corrected with
// a purchase return or a stock adjustment, both of which leave their own row.
// ---------------------------------------------------------------------------

/// A pharmaceutical distributor. Indian regulation requires the drug licence
/// number of whoever supplied a batch to be traceable, so it lives here rather
/// than in a notes field.
model Supplier {
  id              String   @id @default(cuid())
  name            String   @unique
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  /// GST identification number - needed to claim input tax credit on purchases.
  gstin           String?
  /// Form 20/21 drug licence. A supplier without one cannot legally sell.
  drugLicenseNo   String?
  /// Credit period agreed with the distributor, in days. Drives "payment due".
  paymentTermDays Int      @default(30)
  active          Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  purchaseReturns PurchaseReturn[]
  batches         StockBatch[]
  preferredFor    Medicine[]       @relation("MedicinePreferredSupplier")

  @@index([active, name])
}

/// What we asked a distributor to send. Money here is INDICATIVE - the real
/// figure is on the supplier's invoice, captured on the goods receipt, because
/// rates and free-goods schemes change between order and delivery.
model PurchaseOrder {
  id           String              @id @default(cuid())
  poNumber     String              @unique
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?           @db.Date
  notes        String?

  /// Order value at the rates quoted when it was raised.
  subtotal    Decimal @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @default(0) @db.Decimal(12, 2)

  sentAt       DateTime?
  closedAt     DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdById String
  createdBy   User     @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  @@index([status, createdAt])
  @@index([supplierId, createdAt])
}

/// One medicine on an order. `qtyReceived` is a running total maintained by
/// goods receipts - never typed in - and it is what tells the pharmacist a PO
/// is short.
model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicineId      String
  medicine        Medicine      @relation(fields: [medicineId], references: [id])

  qtyOrdered  Int
  qtyReceived Int     @default(0)
  /// Rate the distributor quoted, per unit, before tax. NOT the MRP.
  unitCost    Decimal @db.Decimal(10, 2)
  gstRatePct  Decimal @default(0) @db.Decimal(4, 2)
  /// "10+1 free" schemes are standard in Indian pharma distribution. Free units
  /// arrive as stock but cost nothing, which is what makes the margin real.
  freeQty     Int     @default(0)

  receiptItems GoodsReceiptItem[]

  @@unique([purchaseOrderId, medicineId])
  @@index([medicineId])
}

/// GRN - Goods Receipt Note. The moment stock legally becomes ours. This is the
/// ONLY path by which supplier stock enters the shelf, so every batch traces
/// back to a document, a distributor and a person.
model GoodsReceipt {
  id              String         @id @default(cuid())
  grnNumber       String         @unique
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  /// Null for a direct receipt - an emergency indent bought without raising a PO.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  /// The distributor's own invoice - what accounts pays against.
  invoiceNo     String?
  invoiceDate   DateTime? @db.Date
  /// What the supplier billed. Compared against `receivedValue` below; a gap
  /// means the invoice and the carton disagree, and somebody must look.
  invoiceAmount Decimal?  @db.Decimal(12, 2)
  /// What actually came out of the carton, valued at the receipt's own rates.
  receivedValue Decimal   @default(0) @db.Decimal(12, 2)
  notes         String?

  receivedById String
  receivedBy   User     @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id])
  createdAt    DateTime @default(now())

  items GoodsReceiptItem[]

  @@index([supplierId, createdAt])
  @@index([purchaseOrderId])
  @@index([createdAt])
}

/// One batch off one carton. Immutable once written - it IS the audit record of
/// what arrived, and it pins the batch it created.
model GoodsReceiptItem {
  id                  String             @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  medicineId          String
  medicine            Medicine           @relation(fields: [medicineId], references: [id])
  /// The shelf batch this receipt created or topped up.
  batchId             String
  batch               StockBatch         @relation(fields: [batchId], references: [id])

  batchNo    String
  expiryDate DateTime @db.Date
  qty        Int
  freeQty    Int      @default(0)
  unitCost   Decimal  @db.Decimal(10, 2)
  mrp        Decimal  @db.Decimal(10, 2)

  @@index([goodsReceiptId])
  @@index([medicineId])
  @@index([batchId])
}

/// Stock going back to the distributor. Near-expiry credit is a routine part of
/// Indian pharmacy economics - a shelf without it silently eats its own margin.
model PurchaseReturn {
  id             String               @id @default(cuid())
  returnNo       String               @unique
  supplierId     String
  supplier       Supplier             @relation(fields: [supplierId], references: [id])
  status         PurchaseReturnStatus @default(DRAFT)
  /// Expiry credit, damaged in transit, wrong item supplied, recall.
  reason         String
  /// Value claimed from the distributor, at the rate we paid.
  claimValue     Decimal              @default(0) @db.Decimal(12, 2)
  /// What they actually credited. Differs from the claim more often than not.
  creditNoteNo   String?
  creditedAmount Decimal?             @db.Decimal(12, 2)
  sentAt         DateTime?
  settledAt      DateTime?
  notes          String?

  createdById String
  createdBy   User     @relation("PurchaseReturnCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PurchaseReturnItem[]

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
}

model PurchaseReturnItem {
  id               String         @id @default(cuid())
  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  medicineId       String
  medicine         Medicine       @relation(fields: [medicineId], references: [id])
  batchId          String
  batch            StockBatch     @relation(fields: [batchId], references: [id])

  batchNo  String
  qty      Int
  /// Rate we paid, so the claim is what we're actually out of pocket.
  unitCost Decimal @db.Decimal(10, 2)

  @@index([purchaseReturnId])
  @@index([batchId])
}

// ---------------------------------------------------------------------------
// Billing - one invoice model for every desk
// ---------------------------------------------------------------------------

/// Consultation, lab and pharmacy all bill through here. One receipt
/// numbering, one GST report, one payment flow; admin's category-wise
/// revenue is GROUP BY source.
model Invoice {
  id                   String              @id @default(cuid())
  receiptNo            String              @unique
  patientId            String
  patient              Patient             @relation(fields: [patientId], references: [id])
  source               InvoiceSource
  status               InvoiceStatus       @default(PENDING)
  /// Set for consultation invoices (and lab invoices raised off a visit).
  appointmentId        String?
  appointment          Appointment?        @relation(fields: [appointmentId], references: [id])
  /// Set for pharmacy invoices raised against a scanned prescription.
  prescriptionUploadId String?
  prescriptionUpload   PrescriptionUpload? @relation(fields: [prescriptionUploadId], references: [id])
  /// Set for IPD (discharge) invoices.
  admissionId          String?
  admission            Admission?          @relation(fields: [admissionId], references: [id])

  subtotal       Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  taxableAmount  Decimal @db.Decimal(10, 2)
  cgstAmount     Decimal @db.Decimal(10, 2)
  sgstAmount     Decimal @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)

  // ── HOW THIS BILL GETS SETTLED ────────────────────────────────────────────
  //
  // Separate from the four buyer columns below, which are a GST question. This
  // is a CASH question: did money arrive at a counter, or is this bill sitting
  // with an insurer? A cashless bill to an insurer with no GSTIN is INSURANCE
  // here and still B2C down there, and both statements are true.
  //
  // Every reconciliation reads this. See PayerType for why it can't be inferred
  // from "has no payments yet" - an unpaid self-pay bill is a debt to chase, an
  // INSURANCE bill is not, and the day close must not confuse the two.
  payer     PayerType @default(SELF_PAY)
  /// The insurer/TPA this went to, snapshotted so a bill can print and a day
  /// close can group without joining through the claim.
  payerName String?

  // ── WHO IS BEING BILLED, when it isn't the patient ────────────────────────
  //
  // All four are null for an ordinary counter bill, which is B2C - the patient
  // pays for themselves and is not GST-registered. They are set only when the
  // bill goes to a REGISTERED business instead: an insurer or TPA on a cashless
  // claim, or a corporate health-check client.
  //
  // That distinction is the whole reason these columns exist. e-Invoicing is a
  // B2B obligation; a bill with no buyer GSTIN is out of scope for an IRN no
  // matter what the hospital's turnover is. Storing the buyer here rather than
  // on Patient is deliberate - the same patient can be self-paying on Monday
  // and billed to their employer on Friday, and the bill is what carries the
  // tax position, not the person.
  /// The recipient's GSTIN. Its presence is what makes a bill B2B.
  buyerGstin     String?
  /// Registered name of the buyer, as it appears against that GSTIN.
  buyerLegalName String?
  buyerAddress   String?
  /// Two-digit GST state code of the buyer. See HospitalConfig.stateCode.
  buyerStateCode String?

  notes       String?
  paidAt      DateTime?
  cancelledAt DateTime?
  createdById String
  createdBy   User      @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  items    InvoiceItem[]
  payments Payment[]
  refunds  Refund[]
  eInvoice EInvoice?

  @@index([patientId, createdAt])
  @@index([source, createdAt])
  @@index([status])
  /// Day close splits one local day's bills into "money" and "with the insurer".
  /// Without this the split scans every invoice ever raised, once per shift close.
  @@index([payer, createdAt])
}

/// The government's record of one bill, held alongside our own.
///
/// Kept in its OWN table rather than as columns on Invoice for two reasons.
/// First, almost every invoice this hospital raises is B2C and will never have
/// one - eight mostly-null columns on the busiest table in the system is a poor
/// trade. Second, the signed payload and QR the IRP returns are large text
/// blobs, and they would be dragged into every invoice list query that does
/// `select *`.
///
/// The signed fields are stored verbatim, exactly as the IRP returned them.
/// They are digitally signed by the government: re-deriving, reformatting or
/// "tidying" them destroys the signature and with it the only proof the
/// hospital has that the invoice was ever registered.
model EInvoice {
  id        String         @id @default(cuid())
  invoiceId String         @unique
  invoice   Invoice        @relation(fields: [invoiceId], references: [id])
  status    EInvoiceStatus @default(PENDING)

  /// Which route reached the IRP - "MANUAL", or a GSP's name. Recorded per
  /// row, not read from config, because config changes and history shouldn't.
  provider String @default("MANUAL")

  // ── WHAT THE IRP GAVE BACK ────────────────────────────────────────────────
  /// The 64-character Invoice Reference Number. Null until registered.
  irn           String?   @unique
  /// Acknowledgement number and timestamp from the portal.
  ackNo         String?
  ackDt         DateTime?
  /// The signed QR the portal returns, verbatim. This is what gets printed -
  /// it is NOT a QR we draw from the invoice ourselves, and the difference is
  /// the entire legal point of it.
  signedQrCode  String?   @db.Text
  /// The signed invoice JWT, kept for audit. Rarely read, never edited.
  signedInvoice String?   @db.Text

  // ── WHAT WE SENT, AND WHAT WENT WRONG ─────────────────────────────────────
  /// The exact payload submitted. Kept so a rejection can be diagnosed against
  /// what actually went, not against what the invoice looks like today.
  payloadJson  String? @db.Text
  errorCode    String?
  errorMessage String? @db.Text

  cancelledAt  DateTime?
  /// The IRP requires a reason code and free text to cancel.
  cancelReason String?

  generatedById String?
  generatedBy   User?     @relation("EInvoiceGeneratedBy", fields: [generatedById], references: [id])
  generatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  description String
  /// HSN (goods) / SAC (services) code printed on GST invoices.
  hsnSac      String?
  qty         Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2)
  gstRatePct  Decimal @default(0) @db.Decimal(4, 2)

  /// Pharmacy line -> exact batch dispensed (full traceability).
  batchId   String?
  batch     StockBatch? @relation(fields: [batchId], references: [id])
  /// Lab line -> the test being billed.
  labTestId String?
  labTest   LabTest?    @relation(fields: [labTestId], references: [id])

  @@index([invoiceId])
}

/// Split payments are real (half cash, half UPI). Invoice.status is derived
/// from the sum of its payments at the service layer.
model Payment {
  id           String      @id @default(cuid())
  invoiceId    String
  invoice      Invoice     @relation(fields: [invoiceId], references: [id])
  mode         PaymentMode
  amount       Decimal     @db.Decimal(10, 2)
  /// UPI transaction ref / card auth code.
  reference    String?
  receivedById String
  receivedBy   User        @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  createdAt    DateTime    @default(now())

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Audit, OTP, sessions, counters
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  /// Exactly one of the two actors is set (staff action vs patient action).
  actorUserId    String?
  actorUser      User?    @relation(fields: [actorUserId], references: [id])
  actorPatientId String?
  actorPatient   Patient? @relation(fields: [actorPatientId], references: [id])
  action         String
  targetTable    String
  targetId       String
  meta           Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([targetTable, targetId])
  @@index([actorUserId, createdAt])
  @@index([actorPatientId, createdAt])
  /// The admin page's default view is ORDER BY createdAt DESC with no filter, and
  /// the date-range filter reads this column alone. Without an index on it by
  /// itself, both sort the whole table: fine at 300 rows, several seconds at the
  /// ~480,000 rows a year that 150 OP visits a day produce.
  @@index([createdAt])
  /// Serves the action filter, whose values come from a dropdown of exact action
  /// names, with createdAt trailing so the ordering comes off the same index.
  @@index([action, createdAt])
}

model Otp {
  id          String    @id @default(cuid())
  /// Exactly one of patientId / userId is set (patient OTP vs staff OTP).
  patientId   String?
  patient     Patient?  @relation(fields: [patientId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  /// Destination the code was sent to (masked phone or email) - for display.
  destination String?
  phone       String?
  /// Never store the raw 6-digit code - SHA-256 hash only.
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([patientId, createdAt])
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  /// Staff session -> userId set. Patient session -> patientId set.
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  patientId String?
  patient   Patient?  @relation(fields: [patientId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([patientId])
  @@index([expiresAt])
}

/// Year-scoped atomic counters behind every human-facing ID
/// (JMH-2026-000123, OP-2026-000045, INV-2026-000312).
model Counter {
  key   String @id
  value Int    @default(0)
}

/// Single-row hospital configuration used on invoices (GSTIN, legal name, address).
/// Seeded once; editable by admin later.
/// A ward groups beds and carries the daily bed charge.
/// GST note: hospital room rent above ₹5,000/day (non-ICU) attracts 5% GST
/// without ITC; at or below that, and ICU, it's exempt. Default 0 - the
/// admin sets the rate per ward with the CA.
/// A single line on an inpatient's running tab. Everything done during the stay -
/// a dressing, an oxygen hour, a doctor's round, medicines sent up from the
/// pharmacy - lands here, and the whole ledger is billed once at discharge.
/// Money is snapshotted (unitPrice/gstRatePct), so later price changes never
/// rewrite a stay that already happened.
model AdmissionCharge {
  id          String    @id @default(cuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  category    ChargeCategory @default(OTHER)
  description String
  qty         Int            @default(1)
  unitPrice   Decimal        @db.Decimal(10, 2)
  gstRatePct  Decimal        @default(0) @db.Decimal(4, 2)

  /// Set when the pharmacy posted this to the room. Stops the same dispense
  /// being charged twice, and lets us trace a line back to the batch it came from.
  sourceRef String?

  addedById String
  addedBy   User     @relation("AdmissionChargeAddedBy", fields: [addedById], references: [id])
  createdAt DateTime @default(now())

  @@index([admissionId])
}

/// Which board a service is printed on. The hospital's rate card is three lists
/// on two boards on the wall, and staff look for a charge the way it is grouped
/// there - so the picker groups it the same way.
enum ServiceGroup {
  IP_CHARGE
  SURGERY_OPEN
  SURGERY_LAPAROSCOPIC
  OTHER
}

/// THE HOSPITAL'S PUBLISHED RATE CARD for everything that is not a bed, a lab
/// test or a medicine - DMO charges, oxygen, nebulisation, and every surgery.
///
/// Until this existed the running tab took a free-typed description and a
/// free-typed price, which is how the same procedure got billed at three
/// different rates by three shifts, and how the board on the wall and the bill
/// at the desk drifted apart with nobody able to say which was right.
///
/// The rate here is the COUNTER rate - what the board promises a walk-in family.
/// It is a starting point, never a lock: an insurer settles against its own
/// tariff, so a line raised from this catalogue is repriced on the claim (see
/// updateAdmissionCharge). Both figures matter and they are different numbers.
model ServiceCharge {
  id    String       @id @default(cuid())
  name  String       @unique
  group ServiceGroup @default(IP_CHARGE)
  /// Which running-tab heading a line raised from this lands under, so the
  /// printed claim bill files it in the right section without anyone choosing.
  category ChargeCategory @default(OTHER)

  price      Decimal @db.Decimal(10, 2)
  gstRatePct Decimal @default(0) @db.Decimal(4, 2)
  /// Charged for each day of the stay (oxygen, monitor) rather than once. The
  /// desk still confirms the quantity - a patient is not always on oxygen for
  /// every night they are in the bed.
  perDay Boolean @default(false)
  active Boolean @default(true)

  @@index([group, active])
}

model Ward {
  id          String  @id @default(cuid())
  name        String  @unique
  /// GENERAL / SEMI_PRIVATE / PRIVATE / ICU - kept as text so the hospital
  /// can name their own categories.
  category    String
  floor       String?
  dailyCharge Decimal @default(0) @db.Decimal(10, 2)
  gstRatePct  Decimal @default(0) @db.Decimal(4, 2)
  active      Boolean @default(true)

  beds Bed[]
}

model Bed {
  id     String    @id @default(cuid())
  wardId String
  ward   Ward      @relation(fields: [wardId], references: [id])
  bedNo  String
  status BedStatus @default(AVAILABLE)

  admissions Admission[]
  bedStays   BedStay[]

  @@unique([wardId, bedNo])
  @@index([wardId, status])
}

/// An inpatient stay. The bed-charge rate is snapshotted at admission so a
/// later ward-price change can't rewrite a bill mid-stay.
model Admission {
  id       String @id @default(cuid())
  /// JMH2026IP00001
  ipNumber String @unique

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  bedId String
  bed   Bed    @relation(fields: [bedId], references: [id])

  /// The attending / referred doctor inside the hospital.
  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  /// Why they were admitted - provisional diagnosis or reason, free text.
  reason String?

  /// The caring person staying with the patient.
  attendantName     String?
  attendantPhone    String?
  attendantRelation String?

  // ── WHO IS PAYING FOR THIS STAY ───────────────────────────────────────────
  //
  // Asked once, at the desk, while the family is standing there. This is the
  // ONLY handoff between reception and the insurance room: without it nobody in
  // that room ever learns the patient exists, and the whole claim is remembered
  // by somebody shouting down a corridor.
  //
  // The policy is snapshotted here rather than read off a claim, because the
  // claim is raised later - often days later - and the stay has to be findable
  // as an insurance stay from the moment the bed is assigned.
  payerType PayerType @default(SELF_PAY)
  /// Insurer or TPA name. Free text - the picker offers the common ones but a
  /// hospital meets a new TPA every few months.
  insurer   String?
  policyNo  String?
  memberId  String?

  dailyChargeAtAdmit Decimal @db.Decimal(10, 2)
  wardNameAtAdmit    String
  gstRatePctAtAdmit  Decimal @default(0) @db.Decimal(4, 2)

  status         AdmissionStatus @default(ADMITTED)
  admittedAt     DateTime        @default(now())
  dischargedAt   DateTime?
  admittedById   String
  dischargedById String?
  /// DEPRECATED - superseded by AdmissionNote. Read by nothing; kept for one
  /// release so the backfill in 20260802_admission_notes can be checked against
  /// the original text before the column is dropped.
  notes          String?

  invoices Invoice[]

  /// Nursing / observation entries, append-only. Never updated, never deleted:
  /// an overwritten ward note is the weakest possible record if a stay is ever
  /// questioned, and this stay already distinguishes LAMA from ABSCONDED
  /// precisely because that distinction has to survive being challenged.
  noteEntries         AdmissionNote[]
  charges             AdmissionCharge[]
  prescriptionUploads PrescriptionUpload[]

  labTests LabTest[]
  bedStays BedStay[]
  advances AdmissionAdvance[]

  @@index([status, admittedAt])
  @@index([patientId])
  /// The insurance desk's landing list: insurance patients currently in a bed.
  @@index([payerType, status])
}

/// One nursing / observation entry against a stay.
///
/// APPEND-ONLY BY CONTRACT. There is no update path and no delete path in the
/// service layer, and there should never be one. The column this replaced was a
/// single mutable `Admission.notes` string, which meant the evening shift's
/// entry destroyed the morning's - no author, no time, no history. That is fine
/// for a scratchpad and indefensible for a ward record.
///
/// A correction is written as a NEW entry that says what it corrects. That is
/// how it is done on paper and it is the only version that survives a challenge.
model AdmissionNote {
  id          String    @id @default(cuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  body String            @db.Text
  kind AdmissionNoteKind @default(NURSING)

  /// Who wrote it. NULL ONLY on rows backfilled from the old Admission.notes
  /// column, where the author genuinely was never recorded - the print and the
  /// ward list both say so rather than guessing a name.
  authorId String?
  author   User?   @relation("AdmissionNoteAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([admissionId, createdAt])
}

model HospitalConfig {
  id               String  @id @default(cuid())
  legalName        String
  addressLine      String
  city             String
  state            String
  stateCode        String  @default("36") // Telangana GST state code
  pincode          String
  gstin            String?
  phone            String?
  email            String?
  /// Default GST rate applied to NEW lab catalog entries (%). 0 = exempt (correct
  /// default for diagnostic services). Admin/CA can override per test.
  defaultLabGstPct Decimal @default(0) @db.Decimal(4, 2)

  // ── BRANDING ──────────────────────────────────────────────────────────────
  /// The logo, held as a base64 data URI rather than a file path.
  ///
  /// The obvious alternative - write it to /public - does not survive a deploy on
  /// any serverless host, so the hospital's logo would silently revert to the
  /// stock one every release. Patient records deliberately live on local disk
  /// (see src/lib/storage.ts), but that store is PRIVATE and auth-gated, which is
  /// exactly wrong for a logo that has to render on a printed bill and a login
  /// screen. A logo is small, public, and changes about once a year - the column
  /// is the honest place for it. Capped at 512 KB by the validator.
  logoDataUrl    String? @db.Text
  /// Shown in the portal sidebar and on the login screens. Was hardcoded "Jeeva".
  brandName      String  @default("Jeeva")
  /// One line under the brand on sign-in screens. Optional.
  tagline        String?
  /// The browser tab icon, held as a data URI for the same reason as the logo:
  /// a file written to /public does not survive a deploy.
  ///
  /// Kept SEPARATE from logoDataUrl rather than reusing it, because the two have
  /// different jobs. A logo is wide, detailed and read at 200px on a printed
  /// bill; a favicon is square and read at 16px in a tab strip. Scaling the
  /// letterhead down to 16px reliably produces a grey smudge, so the hospital
  /// gets to choose a mark that actually survives being that small.
  faviconDataUrl String? @db.Text

  // ── WHAT PRINTS ON A BILL ─────────────────────────────────────────────────
  /// Free text at the foot of every invoice - terms, a refund policy, a helpline.
  invoiceFooterNote String? @db.Text

  // ── e-INVOICING (IRN) ─────────────────────────────────────────────────────
  //
  // Off by default, and it should stay off until two things are true: the
  // hospital's turnover has crossed the e-invoicing threshold, AND it actually
  // raises B2B bills (insurer, TPA, corporate). A hospital billing only walk-in
  // patients has no e-invoicing obligation at any turnover, because every one
  // of those bills is B2C.
  /// Show the "Accounts & GST" tab in the admin console.
  ///
  /// On by default: the screen behind it is useful the day it exists, and a
  /// feature that ships hidden is a feature nobody finds. A hospital whose CA
  /// doesn't use Tally and who raises no B2B bills can turn it off to keep the
  /// sidebar honest. Hiding the tab does NOT disable the routes behind it -
  /// this is tidiness, not a permission, and the API stays ADMIN-gated either way.
  accountsTabEnabled Boolean @default(true)

  /// Master switch. When off, nothing is ever submitted to the IRP.
  eInvoiceEnabled  Boolean @default(false)
  /// How we reach the Invoice Registration Portal.
  ///
  /// "MANUAL" means a human registers the bill on the government portal (or the
  /// NIC offline tool) and pastes the IRN, acknowledgement and signed QR back in
  /// here. That is not a placeholder - it is how a hospital doing a handful of
  /// B2B bills a month genuinely operates, and it needs no GSP contract.
  /// Any other value names a GSP adapter; see src/server/irp/.
  eInvoiceProvider String  @default("MANUAL")

  // ── TALLY EXPORT: LEDGER NAMES ────────────────────────────────────────────
  //
  // Tally matches vouchers to ledgers BY NAME, exactly. A ledger that doesn't
  // already exist in the company file makes the import fail (or, worse, silently
  // create a duplicate), so these have to be whatever the hospital's CA actually
  // called them - not what we think they should be called. Defaults are the
  // conventional Tally names and will be wrong for somebody.
  /// Must match the company name in Tally exactly, or the import is refused.
  tallyCompanyName       String?
  /// Income ledgers, one per revenue stream, so the P&L separates them.
  tallySalesConsultation String  @default("Consultation Income")
  tallySalesLab          String  @default("Laboratory Income")
  tallySalesPharmacy     String  @default("Pharmacy Sales")
  tallySalesIpd          String  @default("Inpatient Income")
  tallySalesOther        String  @default("Other Income")
  /// Where the money landed.
  tallyCashLedger        String  @default("Cash")
  tallyBankLedger        String  @default("Bank Account")
  /// The party ledger a credit bill sits against until it is settled.
  tallyDebtorLedger      String  @default("Sundry Debtors")
  /// Output tax. Only ever used on lines that actually carry GST.
  tallyCgstLedger        String  @default("Output CGST")
  tallySgstLedger        String  @default("Output SGST")

  // ── PHARMACY BEHAVIOUR ────────────────────────────────────────────────────
  /// How far ahead a batch counts as "expiring soon". Was hardcoded to 90 days,
  /// which suits a fast-moving retail counter and not a hospital that buys in
  /// bulk twice a year.
  expiryAlertDays Int @default(90)

  // ── WARD BEHAVIOUR ────────────────────────────────────────────────────────
  /// Refuse a discharge while pharmacy or lab bills on that stay are unpaid.
  /// On by default. A hospital that settles dues after discharge can turn it off,
  /// but it should be a decision somebody made, not an accident.
  blockDischargeOnDues Boolean @default(true)

  // ── AFTER-HOURS OP (EMERGENCY PRICING) ────────────────────────────────────
  //
  // Once the evening OP clinic closes, a doctor who comes in is being called in
  // - so the visit is an EMERGENCY and it carries a higher consultation fee.
  // The multiplier is stored, not the doubled amount, because the day fee lives
  // on each Doctor and differs between them: a ₹500 physician and a ₹900
  // specialist must both become "double", not both become one flat number.
  /// Master switch. Off = the clock never changes what an OP visit costs.
  afterHoursOpEnabled    Boolean @default(true)
  /// Window start, local wall clock "HH:MM" (24h). Inclusive.
  afterHoursOpStart      String  @default("20:00")
  /// Window end, local "HH:MM" (24h). Exclusive. May be EARLIER than the start,
  /// which means the window crosses midnight - 20:00→06:00 covers the 2 AM
  /// visit, which is precisely the one nobody should be charging a day fee for.
  afterHoursOpEnd        String  @default("06:00")
  /// What the day fee is multiplied by inside the window. 2 = double.
  afterHoursOpMultiplier Decimal @default(2) @db.Decimal(4, 2)

  // ── WHAT THE PUBLIC SITE CAN DO ───────────────────────────────────────────
  /// Master switch for online appointment booking.
  onlineBookingEnabled    Boolean @default(true)
  /// Master switch for the "request a callback" form.
  callbackRequestsEnabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}

/// Money going BACK to a patient. Deliberately NOT a negative Payment:
/// a refund has its own reason, its own authoriser, and must never be
/// mistaken for income in a report. You cannot refund what was never collected.
model Refund {
  id           String      @id @default(cuid())
  invoiceId    String
  invoice      Invoice     @relation(fields: [invoiceId], references: [id])
  mode         PaymentMode
  amount       Decimal     @db.Decimal(10, 2)
  /// REQUIRED. Nobody hands cash back across a hospital counter without a reason.
  reason       String
  reference    String?
  refundedById String
  refundedBy   User        @relation("RefundedBy", fields: [refundedById], references: [id])
  createdAt    DateTime    @default(now())

  @@index([invoiceId])
  @@index([createdAt])
}

/// One row per BED a patient occupies during a stay.
///
/// An admission used to carry a single `dailyChargeAtAdmit`, which silently
/// assumed nobody ever moves bed. They do - General to ICU is the most common
/// event in a hospital. Billing a whole stay at one rate would either rob the
/// patient or rob the hospital, so each leg of the stay is priced on its own.
model BedStay {
  id          String    @id @default(cuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id])
  bedId       String
  bed         Bed       @relation(fields: [bedId], references: [id])

  /// Snapshots - a ward price revision must never re-price a stay already in progress.
  wardName    String
  dailyCharge Decimal @db.Decimal(10, 2)
  gstRatePct  Decimal @default(0) @db.Decimal(5, 2)

  fromDate DateTime  @default(now())
  /// null = they are in this bed right now.
  toDate   DateTime?
  reason   String?

  movedById String
  movedBy   User     @relation("BedStayMovedBy", fields: [movedById], references: [id])
  createdAt DateTime @default(now())

  @@index([admissionId])
  @@index([bedId])
}

/// The deposit taken at admission. Every hospital takes one; without it a family
/// can walk out owing lakhs. Adjusted against the discharge bill - and if the
/// advance exceeds the final bill, the difference is REFUNDED, not kept.
model AdmissionAdvance {
  id           String      @id @default(cuid())
  admissionId  String
  admission    Admission   @relation(fields: [admissionId], references: [id])
  /// Human-facing number on the slip handed to the family - ADV-2026-000012.
  /// NULLABLE only for rows taken before receipts existed; every new advance
  /// gets one. Its own Counter series, never the tax-invoice series: a deposit
  /// is money held against a stay, not a supply.
  receiptNo    String?     @unique
  mode         PaymentMode
  amount       Decimal     @db.Decimal(10, 2)
  reference    String?
  receivedById String
  receivedBy   User        @relation("AdvanceReceivedBy", fields: [receivedById], references: [id])
  createdAt    DateTime    @default(now())

  @@index([admissionId])
}

/// An insurance claim raised against a patient's treatment - cashless or
/// reimbursement. Policy details are snapshotted onto the claim so the record
/// stays true even if the patient's cover changes later. Optionally linked to
/// the admission (IPD) and the hospital invoice it's claiming against.
model InsuranceClaim {
  id      String @id @default(cuid())
  claimNo String @unique

  patientId   String
  patient     Patient @relation("PatientClaims", fields: [patientId], references: [id])
  admissionId String?
  invoiceId   String?

  // payer + policy snapshot
  insurer    String
  policyNo   String
  memberId   String?
  sumInsured Decimal? @db.Decimal(12, 2)

  type   ClaimType   @default(CASHLESS)
  stage  ClaimStage  @default(PRE_AUTH)
  status ClaimStatus @default(DRAFT)

  diagnosis      String?
  claimedAmount  Decimal  @db.Decimal(12, 2)
  approvedAmount Decimal? @db.Decimal(12, 2)
  settledAmount  Decimal? @db.Decimal(12, 2)
  /// The insurer's / TPA's own reference (authorization or claim number).
  insurerRef     String?
  remarks        String?

  submittedAt DateTime?
  decisionAt  DateTime?
  settledAt   DateTime?

  createdById String
  createdBy   User     @relation("ClaimCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events ClaimEvent[]

  @@index([status, createdAt])
  @@index([patientId])
}

/// One entry on a claim's timeline - every submission, query, decision and
/// settlement. This is the audit trail; the claim's status is derived from it.
model ClaimEvent {
  id        String         @id @default(cuid())
  claimId   String
  claim     InsuranceClaim @relation(fields: [claimId], references: [id])
  /// CREATED · SUBMITTED · QUERIED · APPROVED · PARTIALLY_APPROVED · REJECTED · SETTLED · NOTE
  kind      String
  detail    String?
  amount    Decimal?       @db.Decimal(12, 2)
  byId      String
  by        User           @relation("ClaimEventBy", fields: [byId], references: [id])
  createdAt DateTime       @default(now())

  @@index([claimId, createdAt])
}

/// One staff sign-in session - when they logged in and out. Powers the admin
/// "who was on shift, and for how long" view. Patients are not tracked here.
model StaffSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserSessions", fields: [userId], references: [id])
  /// OTP or PASSWORD.
  method    String
  ipAddress String?
  userAgent String?
  loginAt   DateTime  @default(now())
  logoutAt  DateTime?

  @@index([userId, loginAt])
  @@index([loginAt])
}

/// One FAILED staff password attempt. Successes are not recorded here (they are
/// StaffSession rows); this table exists only to count failures in a window.
///
/// WHY FAILURES AGAINST UNKNOWN USERNAMES ARE RECORDED TOO. If only real accounts
/// were counted, a 429 would mean "this username exists" and the throttle would
/// become the account enumeration oracle that staffLogin's constant-time password
/// check exists to prevent. Counting every attempt keeps the two responses
/// indistinguishable.
model LoginAttempt {
  /// Lowercased, trimmed username as typed - the throttle key, not a foreign key.
  /// Case variation would otherwise buy an attacker a fresh allowance per casing.
  username  String
  ipAddress String?
  createdAt DateTime @default(now())
  id        String   @id @default(cuid())

  @@index([username, createdAt])
  @@index([ipAddress, createdAt])
  @@index([createdAt])
}

/// A server-side crash, kept so a 500 at the billing counter is not invisible.
///
/// WHY THIS TABLE AND NOT A HOSTED ERROR SERVICE. An unhandled error in this app
/// carries patient data by construction: the path holds a UHID, a Prisma message
/// quotes the column value that broke a constraint. Posting that to a third-party
/// cloud makes every crash a small disclosure of health data, which is a DPDP
/// question nobody wants to answer for a 50-bed hospital. The hospital already
/// owns a Postgres; the honest place for its crashes is inside it.
///
/// ONE ROW PER DISTINCT BUG, NOT PER OCCURRENCE. `fingerprint` is a hash of the
/// error's shape, so a crash in a hot loop increments `count` instead of writing
/// 40,000 rows and turning the incident into a second incident.
model ErrorLog {
  id          String    @id @default(cuid())
  /// Normalized route, e.g. "POST /api/v1/reception/patients/:id". Deliberately
  /// NOT the raw path - a filled path carries the UHID of a real patient.
  route       String
  method      String
  status      Int       @default(500)
  /// Error constructor name, e.g. "TypeError", "PrismaClientKnownRequestError".
  name        String
  /// Scrubbed: phone numbers, UHIDs and emails are redacted before storage.
  message     String
  /// Scrubbed the same way. Absent when the thrown value carried no stack.
  stack       String?
  /// Stable hash of name + message shape + route. Groups repeats of one bug.
  fingerprint String    @unique
  count       Int       @default(1)
  /// Who hit it, when that is knowable. Null for unauthenticated routes.
  actorUserId String?
  actorRole   String?
  ipAddress   String?
  userAgent   String?
  /// Set when an admin marks it handled. Unresolved count drives the nav badge.
  resolvedAt  DateTime?
  resolvedBy  String?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  @@index([resolvedAt, lastSeenAt])
  @@index([lastSeenAt])
}
