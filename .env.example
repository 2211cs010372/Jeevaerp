# --- Database (Postgres) ---
# Runtime connection. Against Supabase this is the POOLED one (pgbouncer, :6543).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jeeva_erp?schema=public"

# Session connection to the same database (Supabase: :5432, "direct connection").
# Prisma needs it for migrations - pgbouncer in transaction mode cannot run DDL -
# and `npm run backup` needs it because pg_dump cannot work through the pooler
# either. Locally, the same URL as DATABASE_URL is correct.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/jeeva_erp?schema=public"

# --- JWT (generate each with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=replace_with_64_hex_chars_min_32_bytes________________________
JWT_REFRESH_SECRET=replace_with_64_hex_chars_min_32_bytes________________________
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Cookies ---
# Production: .jeevamultispecialityhospital.com  (leading dot = all subdomains)
# Local dev: leave empty
COOKIE_DOMAIN=

# --- Public site URL ---
# The absolute origin used for canonical tags, OpenGraph URLs, JSON-LD and
# EVERY <loc> in sitemap.xml. Must match the property verified in Google Search
# Console EXACTLY, including www-or-not and https - Search Console rejects a
# sitemap whose URLs sit on a different host than the property.
# Unset, it falls back to https://www.jeevamultispecialityhospital.com
# (see src/lib/site.ts). Set it per environment; staging and preview builds
# must NOT advertise the production domain.
NEXT_PUBLIC_SITE_URL=https://www.jeevamultispecialityhospital.com

# --- SMS provider (wire before production; dev logs the OTP to the server console) ---
#
# Fast2SMS is the primary provider. This key alone is enough for every OTP the
# ERP sends - patient login, online booking, callback requests - because the
# `otp` route uses Fast2SMS's own pre-approved template and needs no DLT setup.
#   Dashboard -> Dev API -> API Key
FAST2SMS_API_KEY=

# Optional fallback, the previous provider. Fast2SMS is preferred when both are
# set; SMS_PROVIDER forces one (fast2sms | 2factor).
# TWO_FACTOR_API_KEY=
# SMS_PROVIDER=fast2sms

# --- If Fast2SMS refuses the OTP route (status_code 996) ------------------------
# "Before using OTP Message API, complete website verification."
#
# Two ways out, and the first is usually faster:
#   1. Fast2SMS dashboard -> OTP Message -> complete website verification.
#      Nothing to change here once it is done.
#   2. Register a DLT template whose only variable is the code, e.g.
#         "Your Jeeva Hospital OTP is {#var#}. Do not share it with anyone."
#      then set its id below. OTPs then go out on the DLT route instead.
# SMS_OTP_TEMPLATE=

# --- Appointment confirmation SMS (DLT-registered template) ---------------------
# Only needed for the booking confirmation, which has custom wording. Indian
# carriers reject free-text transactional SMS, so the template must be approved
# first: Fast2SMS dashboard -> DLT -> Add Template.
#
# The template's variables are filled IN ORDER with:
#   name | OP number | doctor | date | time
# so its body must read:
#   "Dear {#var#}, your appointment {#var#} with {#var#} is confirmed for
#    {#var#} at {#var#}. - Jeeva Hospital"
# Order is not validated by the provider - a mismatched template sends
# confidently wrong messages. Until this is set, confirmations are logged, not sent.
# SMS_APPOINTMENT_TEMPLATE=
# SMS_SENDER_ID=JEEVAH

# --- Event notification SMS (each one a SEPARATE DLT registration) --------------
# Wording and variable order for every message live in ONE file:
#   src/server/services/notify.service.ts
# Each sender there states the exact template body to register. Register that
# body, in that order - the provider does not check, and a template whose
# {#var#} slots are ordered differently sends a confident, well-formatted lie.
#
# All optional and all independent. An unregistered one LOGS its message to the
# server console instead of sending, and says so - so notifications can be
# switched on a few at a time as DLT approvals come back, rather than waiting
# for the whole set. There is no SMS_TPL_OP_BOOKED: both the reception desk and
# the website reuse SMS_APPOINTMENT_TEMPLATE above.
#
# PATIENT
# SMS_TPL_OP_CANCELLED=      # name | OP number | date
# SMS_TPL_BILL=              # name | receipt no | amount | balance
# SMS_TPL_PHARMACY_BILL=     # name | receipt no | amount | balance
# SMS_TPL_LAB_REPORT=        # name | test name | Jeeva ID
# SMS_TPL_ADMITTED=          # name | IP number | bed ("ICU BED 2" - ONE variable)
# SMS_TPL_DISCHARGED=        # name | IP number | days | balance
# SMS_TPL_ADVANCE=           # name | amount | IP number
#
# SUPPLIER
# SMS_TPL_SUPPLIER_PO=       # supplier | PO number | line count
#
# ADMIN - these go to SMS_ADMIN_NUMBERS, not to any patient
# SMS_TPL_STOCK_RECEIVED=    # GRN number | supplier | value
# SMS_TPL_LOW_STOCK=         # below-reorder count | out-of-stock count
# SMS_ADMIN_NUMBERS=9876543210,9876543211

# THE KILL SWITCH. Set to "off" to stop every notification above without a
# redeploy - the whole point being that these cost money per message at a
# counter that bills a few hundred times a day. Never affects OTP: that is
# authentication, and switching it off locks patients out of the portal.
# SMS_NOTIFICATIONS=off

# --- Supabase ---
# Publishable key is public-safe (ships to the browser). Never commit the secret/service key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Supabase Storage (patient records + doctor photos) -------------------------
# Project URL. Usually the same as NEXT_PUBLIC_SUPABASE_URL; kept separate so a
# server deployment can point somewhere else if it ever needs to.
SUPABASE_URL=https://your-project.supabase.co
#
# CREDENTIALS - set ONE of the two blocks below. Both reach the same buckets.
# Either way these are SERVER ONLY: each bypasses row-level security, so if one
# ever gets a NEXT_PUBLIC_ prefix it ships to the browser and every patient can
# read every other patient's scans. With neither set, uploads fall back to local
# disk - fine locally, and LOSES FILES on Vercel (ephemeral filesystem).
#
# (a) S3 protocol. Dashboard -> Storage -> S3 connection -> New access key.
#     Preferred when both blocks are filled in. The endpoint is derived from
#     SUPABASE_URL; set SUPABASE_S3_ENDPOINT only to override it.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=ap-south-1
# SUPABASE_S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
#
# (b) Native. Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
#
# Buckets, created once in Dashboard -> Storage:
#   patient-records  PRIVATE  - prescription scans + lab reports (PHI). Must stay
#                               private; files are streamed by
#                               /api/v1/files/prescriptions/[key] after an auth check.
#   doctor-photos    PUBLIC   - doctor portraits shown on the public directory.
SUPABASE_PHI_BUCKET=patient-records
SUPABASE_PUBLIC_BUCKET=doctor-photos

# --- Email (Resend) -------------------------------------------------------------
# BOTH are needed before a single mail leaves the building. With neither, every
# message is logged to the server console instead - except a staff OTP in
# production, which throws rather than dropping a login code silently.
#
#   1. resend.com -> API Keys -> Create
#   2. resend.com -> Domains -> Add jeevamultispecialityhospital.com, then add
#      the three DNS records it shows you. An address on an unverified domain is
#      refused with a 403, which is NOT fixed by retrying.
RESEND_API_KEY=
EMAIL_FROM="Jeeva Hospital <reports@jeevamultispecialityhospital.com>"

# --- WhatsApp -------------------------------------------------------------------
# Business-initiated WhatsApp needs a PRE-APPROVED TEMPLATE, exactly the way
# Indian SMS needs a DLT registration. Free text is only allowed for 24 hours
# after the recipient last messaged the business number, which a 9:30 PM report
# will usually miss - so the daily report sends a template.
#
# Nothing set => every message is logged with its full text and says so. That is
# the honest state until the Meta account exists, and switching WhatsApp on
# later is pasting these in - no code change.
#
# (a) Meta WhatsApp Cloud API. Also the right block for an Indian BSP (AiSensy,
#     Interakt, Wati) that proxies Meta's own request shape - point
#     WHATSAPP_API_BASE at theirs.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
#
# (b) Twilio. Templates are Content SIDs (HX...) there, not names.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
#
# WHATSAPP_PROVIDER=meta        # forces one when both blocks are filled in
#
# The approved template's NAME (Meta) or Content SID (Twilio). The exact body to
# register, and the ORDER its variables must be in, is written out in
# src/lib/daily-report.ts above whatsappReportVars(). Register that body, in that
# order, under category UTILITY - nothing validates the order, and a template
# written differently sends a confident, well-formatted lie.
# WHATSAPP_TPL_DAILY_REPORT=
# WHATSAPP_TPL_LANG=en
#
# "on" allows plain-text sends. Useful while testing, from a number that has just
# messaged the business number - it CANNOT work outside the 24-hour window.
# WHATSAPP_ALLOW_FREE_TEXT=on
#
# The kill switch, twin of SMS_NOTIFICATIONS. Stops every WhatsApp message.
# WHATSAPP_NOTIFICATIONS=off

# --- The daily report -----------------------------------------------------------
# Recipients are normally edited in the admin console (Settings -> Daily report)
# and stored on HospitalConfig. These two are the FALLBACK for whichever list is
# still blank there - and the only source until that migration has been run.
# REPORT_EMAILS=owner@example.com,accounts@example.com
# REPORT_WHATSAPP_NUMBERS=9876543210,9876543211

# The nightly run is scheduled in vercel.json at 16:00 UTC = 9:30 PM IST, and it
# calls /api/v1/cron/daily-report. Set CRON_SECRET on the Vercel project and
# Vercel sends it as a Bearer token on every scheduled call.
#
# WITHOUT IT THE ENDPOINT REFUSES TO RUN. It reads the whole hospital's takings
# and mails them, so an unauthenticated version of it is a data leak with a
# schedule attached. Generate one with: openssl rand -hex 32
CRON_SECRET=
