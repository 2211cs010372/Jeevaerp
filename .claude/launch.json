{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "jeeva-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true,
      "env": { "NEXT_DIST_DIR": ".next-preview" }
    },
    {
      "name": "opc-demo",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3100"],
      "port": 3100,
      "env": {
        "NEXT_DIST_DIR": ".next-demo",
        "DATABASE_URL": "postgresql://demo:demo@127.0.0.1:1/demo_offline",
        "DIRECT_URL": "postgresql://demo:demo@127.0.0.1:1/demo_offline",
        "JWT_ACCESS_SECRET": "opc-demo-local-only-access-secret-not-prod",
        "JWT_REFRESH_SECRET": "opc-demo-local-only-refresh-secret-not-prod",
        "COOKIE_DOMAIN": "localhost",
        "NEXT_PUBLIC_SUPABASE_URL": "http://127.0.0.1:9",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "offline",
        "SMTP_HOST": "127.0.0.1",
        "SMTP_USER": "offline",
        "SMTP_PASS": "offline",
        "CLOUDINARY_CLOUD_NAME": "offline",
        "CLOUDINARY_API_KEY": "offline",
        "CLOUDINARY_API_SECRET": "offline",
        "GEMINI_API_KEY": "offline",
        "AI_API_KEY": "offline"
      }
    }
  ]
}
